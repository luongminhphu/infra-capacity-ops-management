# Copy this file to `.env` and fill in real values before `docker compose up -d`.
# Never commit the real `.env` to git (it is already in .gitignore).

# ---------- PostgreSQL ----------
POSTGRES_USER=ico_app
POSTGRES_PASSWORD=change-me-strong-password
POSTGRES_DB=infra_capacity_ops

# ---------- App / Auth ----------
# Random long string — e.g. `openssl rand -hex 32`
JWT_SECRET=change-me-to-a-long-random-string
ADMIN_USERNAME=admin
# Bootstrap password for the first login (only used the very first time the
# `users` table is empty). Change it after first login, or rotate with:
#   docker compose exec app python -m app.seed --username admin --password 'NewPass!'
ADMIN_PASSWORD=change-me-strong-password
# Set to true once the app is served over HTTPS (behind a reverse proxy / TLS terminator)
COOKIE_SECURE=false

# Restrict in production to your actual frontend origin(s), comma-separated.
# "*" is fine when frontend and backend are served from the same origin
# (the default setup here — FastAPI serves the static frontend itself).
CORS_ORIGINS=*

# ---------- Background polling (vCenter + NetBackup) ----------
ENABLE_SCHEDULER=true
POLL_INTERVAL_MINUTES=60
APP_PORT=8000

# ---------- Tiêu chí đánh giá ----------
# Storage có được đưa vào đánh giá/báo cáo hay không (CPU/RAM luôn bật).
# Mặc định false vì với SAN dùng chung + thick provisioning, % datastore đã cấp
# phát luôn ~100% và không phản ánh dung lượng SAN thực. Có thể bật/tắt lại
# trong UI (nút "Tiêu chí đánh giá"); giá trị trong UI được lưu vào DB và ưu
# tiên hơn biến này sau lần đổi đầu tiên.
INCLUDE_STORAGE=false

# ---------- vCenter #1..#4 ----------
# Use the SAME read-only account (e.g. infra.mon@vsphere.local) on every
# vCenter — see README.md "Tạo tài khoản read-only trên vCenter" for the
# exact custom-role permissions to grant.
# Set VCENTER_i_DEMO=true (and leave HOST/PASSWORD blank) to run against the
# built-in synthetic data generator instead of a real vCenter — useful for a
# first smoke test before you have real vCenter access wired up.

VCENTER_1_KEY=vc-hcm-01
VCENTER_1_NAME=vCenter HCM DC1
VCENTER_1_HOST=vcenter01.yourcompany.local
VCENTER_1_USERNAME=infra.mon@vsphere.local
VCENTER_1_PASSWORD=change-me
VCENTER_1_VERIFY_SSL=false
VCENTER_1_DEMO=false

VCENTER_2_KEY=vc-hcm-02
VCENTER_2_NAME=vCenter HCM DC2
VCENTER_2_HOST=vcenter02.yourcompany.local
VCENTER_2_USERNAME=infra.mon@vsphere.local
VCENTER_2_PASSWORD=change-me
VCENTER_2_VERIFY_SSL=false
VCENTER_2_DEMO=false

VCENTER_3_KEY=vc-dr-01
VCENTER_3_NAME=vCenter DR Site
VCENTER_3_HOST=vcenter03.yourcompany.local
VCENTER_3_USERNAME=infra.mon@vsphere.local
VCENTER_3_PASSWORD=change-me
VCENTER_3_VERIFY_SSL=false
VCENTER_3_DEMO=false

VCENTER_4_KEY=vc-branch-01
VCENTER_4_NAME=vCenter Branch
VCENTER_4_HOST=vcenter04.yourcompany.local
VCENTER_4_USERNAME=infra.mon@vsphere.local
VCENTER_4_PASSWORD=change-me
VCENTER_4_VERIFY_SSL=false
VCENTER_4_DEMO=false

# ---------- Veritas NetBackup #1..#4 (module Backup) ----------
# App chỉ gọi API GET của NetBackup REST API (cổng 1556) bằng tài khoản CHỈ ĐỌC —
# xem README.md "Tài khoản read-only cho NetBackup". Ưu tiên API key (NetBackup 9.x+);
# nếu không có API key thì dùng USERNAME/PASSWORD (+ DOMAIN_TYPE / DOMAIN_NAME).
# Đặt NETBACKUP_i_DEMO=true (bỏ trống HOST) để chạy thử với dữ liệu giả lập.
# API_VERSION: phiên bản media type của API (vd 8.0 cho NetBackup 10.0, 12.0 cho 10.4) —
# lỗi 406 nghĩa là cần chỉnh giá trị này.
# Đồng bộ cùng chu kỳ POLL_INTERVAL_MINUTES; lần đầu lấy BACKUP_INITIAL_DAYS ngày lịch sử job.
BACKUP_INITIAL_DAYS=14
BACKUP_RETENTION_DAYS=400

# Giá trị dưới khớp với cấu hình đang chạy trên cụm Rancher (k8s/01-configmap.yaml).
NETBACKUP_1_KEY=nbu-hsc
NETBACKUP_1_NAME=NetBackup HSC
NETBACKUP_1_HOST=nbu-primary.hsc.com.vn
NETBACKUP_1_PORT=1556
NETBACKUP_1_API_KEY=
NETBACKUP_1_USERNAME=ita_collector_user
NETBACKUP_1_PASSWORD=change-me
NETBACKUP_1_DOMAIN_TYPE=unixpwd
NETBACKUP_1_DOMAIN_NAME=nbu-primary.hsc.com.vn
# Docker Compose: để false, hoặc mount CA vào container và đặt true + NETBACKUP_1_CA_CERT.
NETBACKUP_1_VERIFY_SSL=false
# Khi VERIFY_SSL=true: đường dẫn file PEM chứa CA của NetBackup (NetBackup dùng CA nội bộ).
# Để trống = dùng kho CA của hệ thống. NETBACKUP_CA_CERT (không số) áp dụng chung cho mọi server.
NETBACKUP_1_CA_CERT=
NETBACKUP_1_API_VERSION=8.0
NETBACKUP_1_DEMO=false
# NETBACKUP_2_* .. NETBACKUP_4_*: cùng cấu trúc cho primary server khác (vd site DR).
